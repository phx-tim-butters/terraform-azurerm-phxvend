{
    "git": {
        "requireBranch": "main",
        "requireCleanWorkingDir": true,
        "commit": false,
        "tag": true,
        "tagName": "v${version}",
        "push": true,
        "changelog": "git log --pretty=format:\"- %s (%h)\" ${from}...${to}"
    },
    "npm": false,
    "github": {
        "release": true,
        "releaseName": "v${version}"
    }
}